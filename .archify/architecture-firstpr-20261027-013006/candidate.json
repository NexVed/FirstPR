  "cards": [
    {
      "dot": "cyan",
      "title": "Primary flow",
      "items": [
        "Browser signs in to Supabase Auth and keeps the JWT",
        "Every API call: /api/v1/* client → Next.js rewrite → FastAPI bearer check",
        "Analysis: GitHub fetches → two fixed AI calls → service-role insert + activity row"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundaries",
      "items": [
        "Browser holds only the anon key; service-role key + JWT secret stay in backend env",
        "FastAPI verifies each bearer JWT: HS256 secret or JWKS (RS256/ES256)",
        "Postgres RLS restricts rows to auth.uid(); API writes bypass RLS by design"
      ]
    },
    {
      "dot": "amber",
      "title": "Unknown / not evidenced",
      "items": [
        "No call site does direct browser→Postgres reads, though RLS select policies would allow them",
        "Only local dev topology documented (uvicorn + bun dev); hosting is unknown",
        "Triage history route and per-user preference update routes do not exist yet"
      ]
    }
  ]
